# Copie este arquivo para .env.local e preencha com os valores reais.
# Não comite .env.local — apenas .env.example fica versionado.

# --- Supabase ---
# URL pública do projeto Supabase
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave pública (anon) — exposta ao client, protegida por RLS
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# Chave de service role — USE APENAS NO SERVER (server actions, route handlers).
# Nunca expor ao client. Bypassa RLS.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key
